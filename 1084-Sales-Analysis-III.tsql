WITH x AS (
    SELECT
        p.product_id,
        p.product_name,
        SUM(CASE
            WHEN sale_date >= '2019-01-01'
             AND sale_date < '2019-04-01'
            THEN 1 ELSE 0
        END) AS s,
        COUNT(*) AS c
    FROM Product p
    JOIN Sales s ON p.product_id = s.product_id
    GROUP BY p.product_id, p.product_name
)
SELECT product_id, product_name
FROM x
WHERE s = c;