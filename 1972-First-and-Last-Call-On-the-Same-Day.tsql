with x as (
SELECT caller_id as user_id, recipient_id, call_time as d from calls
UNION ALL
SELECT recipient_id as user_id, caller_id as recipient_id, call_time  as d from calls
)
, y as (
SELECT user_id, first_value(recipient_id) over (partition by user_id, cast(d as date) order by d) as first_caller
,first_value(recipient_id) over (partition by user_id, cast(d as date) order by d desc) as last_caller
from x
)
SELECT distinct user_id from y where first_caller=last_caller
