with x as (SELECT customer_id,product_id, count(*) as f from Orders
group by customer_id,product_id)
, y as (
SELECT customer_id, product_id, dense_rank() over (partition by customer_id order by f desc) as r FROM x)
SELECT customer_id, p.product_id, p.product_name 
FROM y right join Products p on y.product_id= p.product_id
where r=1
