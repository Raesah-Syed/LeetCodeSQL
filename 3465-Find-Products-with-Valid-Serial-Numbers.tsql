SELECT * FROM products
WHERE description COLLATE Latin1_General_CS_AS LIKE 'SN[0-9][0-9][0-9][0-9]-[0-9][0-9][0-9][0-9] %'
or description COLLATE Latin1_General_CS_AS LIKE '% SN[0-9][0-9][0-9][0-9]-[0-9][0-9][0-9][0-9] %'
or description COLLATE Latin1_General_CS_AS LIKE '% SN[0-9][0-9][0-9][0-9]-[0-9][0-9][0-9][0-9]'
or description COLLATE Latin1_General_CS_AS LIKE 'SN[0-9][0-9][0-9][0-9]-[0-9][0-9][0-9][0-9]'
order by product_id