with x as (
    SELECT users_id from Users where banned='No'
)
SELECT request_at as Day,round(sum(case when status!='completed' then 1.0 else 0.0 end)/count(*),2) as 'Cancellation Rate' from trips 
where request_at between '2013-10-01' and '2013-10-03'
and client_id in (SELECT * FROM x) and driver_id in (SELECT * FROM x)
group by request_at