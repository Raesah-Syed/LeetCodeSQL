with final as (SELECT customer_id
,sum(case when transaction_type='purchase' then 1 else 0 end) as pc
,datediff(day,min(transaction_date),max(transaction_date)) as ad
,(sum(case when transaction_type='refund' then 1 else 0 end))*100.0/count(distinct transaction_id) as p
FROM customer_transactions
group by customer_id)
SELECT customer_id FROM final where pc>=3 and ad>=30 and p<20
