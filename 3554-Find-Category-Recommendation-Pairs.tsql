SELECT 
pi1.category as category1,
pi2.category as category2,
count(distinct p1.user_id) as customer_count
FROM ProductPurchases p1 join ProductPurchases p2
on p1.user_id=p2.user_id
join ProductInfo pi1 on p1.product_id=pi1.product_id
join ProductInfo pi2 on p2.product_id=pi2.product_id
where pi1.category<pi2.category
group by pi1.category,pi2.category
having count(distinct p1.user_id)>2
order by customer_count desc, pi1.category,pi2.category