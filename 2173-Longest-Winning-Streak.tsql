with a as (SELECT player_id, match_day, result
,row_number() over (partition by player_id order by match_day) as pr 
,row_number() over (partition by player_id,result order by match_day) as rr
FROM Matches), b as (
SELECT player_id,pr-rr as gr FROM a
where result='Win')
, c as (
SELECT distinct player_id, count(*) as streak FROM b
group by player_id,gr
)
SELECT m.player_id, coalesce(max(streak),0) as longest_streak from (SELECT distinct player_id from matches)m left join c on m.player_id=c.player_id
group by m.player_id