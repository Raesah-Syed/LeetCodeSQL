with x as (SELECT question_id 
, sum(case when action='show' then 1 else 0 end) as show
, count(answer_id) as ans
from SurveyLog
group by question_id)
, y as (
SELECT question_id,row_number() over (order by round(ans*1.0/show,2) desc,question_id) as rate from x )
SELECT question_id as survey_log FROM y where rate=1

