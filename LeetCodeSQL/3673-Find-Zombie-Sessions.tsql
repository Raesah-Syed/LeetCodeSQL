with x as (SELECT session_id
,min(user_id) as user_id
,datediff(minute,min(event_timestamp),max(event_timestamp)) as session_duration_minutes 
,sum(case when event_type='scroll' then 1 else 0 end ) as scroll_count
,sum(case when event_type='click' then 1 else 0 end ) as click_count
,sum(case when event_type='click' then 1 else 0 end )*1.00/sum(case when event_type='scroll' then 1 else 0 end ) as csr
,sum(case when event_type='purchase' then 1 else 0 end ) as pcount
from app_events 
group by session_id
)
SELECT session_id
,user_id
, session_duration_minutes
, scroll_count
 FROM x where session_duration_minutes>30 and scroll_count>4 and csr<0.20 and pcount=0
order by scroll_count desc, session_id
