with y as  (
    SELECT 
    user_id, 
    action_date, 
    lead(action_date) over(partition by user_id order by action_date) as ndate,
    action,
    lead(action) over(partition by user_id order by action_date) as na
    FROM activity
)
SELECT 
user_id, 
action, 
datediff(day,min(action_date),max(ndate))+1 as streak_length,
min(action_date) as start_date,
max(ndate) as end_date 
FROM y 
where datediff(day,action_date,ndate)=1 and action=na
group by user_id,action
having count(*)>=4
order by streak_length desc, user_id