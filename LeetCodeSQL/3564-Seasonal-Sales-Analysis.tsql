with x as (SELECT 
case when month(sale_date) in (12,1,2) then 'Winter' 
when month(sale_date) in (3,4,5) then 'Spring'
when month(sale_date) in (6,7,8) then 'Summer' 
else 'Fall' end as season,
category,
quantity, 
price
from sales s join products p on s.product_id=p.product_id)
, y as (
SELECT season, category, sum(quantity) as total_quantity, 
sum(quantity*price) as total_revenue from x
group by season, category
 )
select season, category, total_quantity, total_revenue from (
select *, row_number() over (partition by season order by total_quantity desc, total_revenue desc, category ) as r from y) x where 
r=1
order by season
