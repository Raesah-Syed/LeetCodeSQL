SELECT *
FROM products
WHERE (
        description LIKE 'SN[0-9][0-9][0-9][0-9]-[0-9][0-9][0-9][0-9]%' COLLATE Latin1_General_BIN
        OR description LIKE '%[^a-zA-Z0-9]SN[0-9][0-9][0-9][0-9]-[0-9][0-9][0-9][0-9]%' COLLATE Latin1_General_BIN
      )
  -- Prevents 5+ digits at the end
  AND description NOT LIKE '%SN[0-9][0-9][0-9][0-9]-[0-9][0-9][0-9][0-9][0-9]%'
  -- Prevents immediate concatenation of another SN or letter right after the serial number
  AND description NOT LIKE '%SN[0-9][0-9][0-9][0-9]-[0-9][0-9][0-9][0-9][a-zA-Z]%'
ORDER BY product_id;