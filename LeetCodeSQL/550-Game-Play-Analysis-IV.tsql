with x as (
    SELECT player_id, min(event_date) as first_login from Activity
    group by player_id)
        Select round((SELECT count(distinct a.player_id) from Activity a join x on a.player_id=x.player_id and 
       datediff(day,x.first_login, a.event_date)=1)*1.0
       /(SELECT count(distinct player_id) from Activity),2) as fraction
    
