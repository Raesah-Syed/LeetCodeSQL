with x as (
SELECT 
year(transaction_date) as 'year'
, product_id
, sum(spend) as curr_year_spend
from user_transactions
group by year(transaction_date), product_id)
, y as (
SELECT year, product_id, curr_year_spend , lag (curr_year_spend) over (partition by product_id order by year) as prev_year_spend 
from x)

SELECT year, product_id,curr_year_spend,prev_year_spend, round(((curr_year_spend-prev_year_spend)*100)/prev_year_spend,2) as yoy_rate from y
--group by year,product_id
order by product_id,year